{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo2drawio:architecture:v1",
  "title": "repo2drawio architecture model",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "nodes", "edges"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["LR", "RL", "TB", "BT"], "default": "LR" },
    "sketch": { "type": "boolean", "default": true },
    "theme": { "enum": ["classic", "icon-sketch", "brand-logos"], "default": "classic" },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" }, "default": [] },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "default": "boundary" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "default": [] },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["actor", "service", "gateway", "database", "storage", "cloud", "model", "queue", "external", "generic"],
          "default": "generic"
        },
        "subtitle": { "type": "string" },
        "parent": { "$ref": "#/$defs/id" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "default": [] },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "default": "" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "default": [] }
      }
    }
  }
}
